# ========= 大模型 API（OpenAI 兼容协议）=========
# 服务商实施期确定；换服务商只改以下三个字段，然后运行 python manage.py reindex 重建向量
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=
LLM_EMBED_MODEL=

# 演示模式：1 = 不调用外部 API，用本地模拟 embedding 与生成（开发自测用）
# 接入真实服务商时必须改为 0
LLM_MOCK=1

# ========= 检索 / 聚合阈值（实施期调参）=========
T1_RELEVANCE=0.75
T2_AGGREGATE=0.82
T3_SIMILAR=0.85

# ========= 认证安全 =========
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILS=5
LOCK_MINUTES=15
SESSION_DAYS=7

# ========= 服务 =========
HOST=127.0.0.1
PORT=8000
RUN_SCHEDULER=1
